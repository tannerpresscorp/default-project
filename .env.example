# Sentry error monitoring. Both Python apps are inert unless their DSN is set.
# These are environment variables: export them in your shell or deployment
# environment. The repo does not load .env files for Django or FastAPI.
# Never commit real DSNs.
PLATFORM_SENTRY_DSN=
PLATFORM_SENTRY_ENVIRONMENT=development
PLATFORM_SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0
