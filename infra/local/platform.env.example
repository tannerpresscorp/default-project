# Local development only. Copy into your shell; do not use these credentials in production.
PLATFORM_DATABASE_URL=postgresql+asyncpg://platform_app:local_app_only@127.0.0.1:55432/platform
PLATFORM_MIGRATION_DATABASE_URL=postgresql+asyncpg://platform_migrator:local_migrator_only@127.0.0.1:55432/platform
PLATFORM_TEST_DATABASE_URL=postgresql+asyncpg://platform_app:local_app_only@127.0.0.1:55432/platform_test
# Temporal worker (start a dev server with `temporal server start-dev`).
PLATFORM_TEMPORAL_ADDRESS=127.0.0.1:7233
PLATFORM_TEMPORAL_NAMESPACE=default
PLATFORM_TEMPORAL_TASK_QUEUE=agent-runs
# Path to the Temporal CLI; required only for the workflow integration tests.
# TEMPORAL_CLI_PATH=/usr/local/bin/temporal
# PLATFORM_OIDC_ISSUER=https://your-trusted-issuer.example/
# PLATFORM_OIDC_AUDIENCE=agent-platform
# PLATFORM_OIDC_JWKS_URL=https://your-trusted-issuer.example/.well-known/jwks.json
# PLATFORM_OIDC_TENANT_CLAIM=tenant_id
